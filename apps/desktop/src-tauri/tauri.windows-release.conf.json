{
  "$schema": "https://schema.tauri.app/config/2",
  "mainBinaryName": "wain-app",
  "bundle": {
    "publisher": "Wain",
    "shortDescription": "Desktop app for coding agents",
    "externalBin": ["target/cli/wain-cli", "target/island-linux/wain-island"],
    "windows": {
      "nsis": { "installMode": "currentUser", "installerHooks": "windows/hooks.nsh" },
      "wix": { "fragmentPaths": ["windows/run-key.wxs"], "componentRefs": ["WainRunKey"] }
    }
  }
}
