{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wain",
  "version": "0.34.3",
  "identifier": "com.wainhq.wain",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Wain",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 9, "y": 20 },
        "transparent": true,
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.wain/attachments/**",
          "$HOME/.wain/browser/recordings/**",
          "$HOME/.wain-dev/attachments/**",
          "$HOME/.wain-dev/browser/recordings/**",
          "$HOME/.wain-worktrees/*/attachments/**",
          "$HOME/.wain-worktrees/*/browser/recordings/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": { "bundleMediaFramework": true }
    },
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA0QUFFNzgzMUVGMEFEODcKUldTSHJmQWVnK2VxQkJzVXlhTG44NEZ3T3EwM3VZQ3lKV2VwUmZFQnNwQ3ZQTS9xNVdIdW5XOFYK",
      "endpoints": ["https://ismatbabirli.github.io/wain/stable.json"]
    }
  }
}
